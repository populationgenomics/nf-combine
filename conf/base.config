// Per-process resources and containers
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    container = params.cpg_container
    resourceLabels = [
        'ar-guid': params.arGuid,
        'dataset': params.dataset,
        'compute-category': 'nextflow',
    ]
    // one VDS per run, so there's no partial result worth carrying on for
    errorStrategy = 'terminate'

    // Every destination is worked out in main.nf and passed in (run_dir, or the COMBINE plan's); these only
    // apply it. The VDS itself is written by the Dataproc job straight to its final path, never published
    withName: 'BUILD_SAMPLESHEET' {
        // the sheet is named for its VDS, but the run records keep a fixed name
        publishDir = [path: { run_dir }, pattern: '*.tsv', saveAs: { 'samplesheet.tsv' }, mode: 'copy']
        cpus = 1
        memory = 4.GB
    }
    // only submits and watches the Dataproc job, but lives as long as the combine does. One retry resumes
    // from the combiner's saved plan, or only registers if the VDS was finished
    withName: 'COMBINE' {
        publishDir = [path: { plan.run_dir }, mode: 'copy']
        cpus = 2
        memory = 4.GB
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'terminate' }
        maxRetries = 1
    }
    // the same shape as COMBINE. A retry reuses the checkpoint, MT and exports its first attempt completed
    withName: 'DENSIFY' {
        publishDir = [path: { plan.run_dir }, pattern: 'densify_output.json', mode: 'copy']
        cpus = 2
        memory = 4.GB
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'terminate' }
        maxRetries = 1
    }

    // VQSR (modules/local/vqsr). Sizes follow cpg-flow-seqr-loader's, untuned here. Every GATK task but GATHER
    // stages the training resources (dbSNP alone is ~11 GB uncompressed), hence the disks
    withName: 'COMPOSE_SITES_ONLY' {
        cpus = 1
        memory = 2.GB
    }
    // each trained on the whole callset: cpg-flow gave each a whole highmem-16
    withName: 'TRAIN_VQSR_INDEL_MODEL|TRAIN_VQSR_SNP_MODEL' {
        cpus = 16
        memory = 104.GB
        disk = 100.GB
    }
    withName: 'TRAIN_VQSR_SNP_TRANCHES' {
        cpus = 4
        memory = 15.GB
        disk = 50.GB
    }
    withName: 'GATHER_VQSR_SNP_TRANCHES' {
        cpus = 2
        memory = 7.GB
        disk = 10.GB
    }
    // SNP and indel VQSR on each shard. Every task stages the genome-wide indel recalibrations (a plain-text VCF)
    withName: 'APPLY_VQSR' {
        cpus = 2
        memory = 7.GB
        disk = 50.GB
    }
    // untuned. Stages annotate_fragments_per_job whole fragments, and writes them again annotated, so the disk scales with
    // the cohort: it's roughly 2 * the whole export / the number of chunks
    withName: 'ANNOTATE_FRAGMENTS' {
        cpus = 4
        memory = 8.GB
        disk = 200.GB
    }

    // dataset VCFs (modules/local/dataset_vcf), all untuned. Each task works for one dataset (plan from
    // planDatasetVcfs() in main.nf), and its compute is billed to it
    withName: 'SUBSET_HEADER|SUBSET_FRAGMENTS|COMPOSE_FRAGMENTS|REHEADER_VCF|REGISTER_DATASET_VCF' {
        resourceLabels = { ['ar-guid': params.arGuid, 'dataset': plan.dataset, 'compute-category': 'nextflow'] }
    }
    // SUBSET_FRAGMENTS stages a chunk of annotated fragments, and writes a dataset's share of them: its disk scales
    // like ANNOTATE_FRAGMENTS', but less than 2x
    withName: 'SUBSET_HEADER' {
        cpus = 1
        memory = 2.GB
    }
    withName: 'SUBSET_FRAGMENTS' {
        cpus = 2
        memory = 4.GB
        disk = 150.GB
    }
    withName: 'COMPOSE_FRAGMENTS' {
        cpus = 1
        memory = 2.GB
    }
    // a registration that fails is retried once
    withName: 'REGISTER_DATASET_VCF' {
        cpus = 1
        memory = 2.GB
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'terminate' }
        maxRetries = 1
    }
    // the disk is sized in the process, from the VCF
    withName: 'REHEADER_VCF' {
        cpus = 2
        memory = 4.GB
    }
}
