manifest {
    name = 'nf-combine'
    description = 'Single-sample gVCFs -> one Hail VDS on an ephemeral Dataproc cluster, driven by Metamist cohorts'
    mainScript = 'main.nf'
    nextflowVersion = '>=26.04'
}

params {
    // what to combine: the SGs of cohorts, queried in Metamist
    dataset                        = null
    sequencing_type                = null  // genome | exome
    accessLevel                    = null  // full | standard, or test: <dataset>-test project and bucket
    arGuid                         = null  // supplied from analysis-runner, used in billing labels and the cluster name
    cohorts                        = null  // COH1,COH2 on the command line, or a list in a config file

    force                          = false // fresh build: no base VDS, and any saved combiner plan is discarded
    base_vds                       = null  // build on this VDS, instead of the newest registered one. Not with force
    refresh                        = null  // SG IDs whose data is replaced from their current gVCF
    register                       = true  // if false, no metamist registration

    // null: the VDS and run records go to the dataset's bucket. Set for local runs: <output_root>/ instead
    output_root                    = null

    // datasets whose VCF is also written with each sample named by its participant's external ID, not its SG ID.
    // DS1,DS2 on the command line, or a list in a config file
    seqr_vcf                       = null

    // the regions the combiner partitions on, chosen by sequencing_type
    exome_combiner_intervals = 'gs://cpg-common-main/rd_references/exome_combiner_intervals/500_var_balanced_intervals.bed'
    exome_densify_intervals = 'gs://cpg-common-main/rd_references/exome_combiner_intervals/100_var_balanced_intervals.bed'

    genome_combiner_intervals = 'gs://cpg-common-main/rd_references/genome_combiner_intervals/1000_var_balanced_intervals.bed'
    genome_densify_intervals = 'gs://cpg-common-main/rd_references/genome_combiner_intervals/500_var_balanced_intervals.bed'

    // combiner tuning, shared by genome and exome until there's exome data to tune on.
    // target_records is the OurDNA cpg-flow default; the other two are tuned for checkpoint frequency.
    target_records                 = 1000000
    branch_factor                  = 100
    gvcf_batch_size                = 5

    // Dataproc cluster. The four with no default must be supplied by the launch config
    dataproc_project               = null   // the GCP project ID the cluster runs in. null: the dataset name
    dataproc_region                = 'australia-southeast1'
    dataproc_autoscaling_policy    = 'cpg-dataproc-medium'
    dataproc_master_type           = 'n1-highmem-8'
    dataproc_worker_type           = 'n1-highmem-16'
    dataproc_num_workers           = 2
    dataproc_num_secondary_workers = 10
    preemptible_secondary_workers  = true
    dataproc_boot_disk_size_gb     = 100
    dataproc_num_local_ssds        = 1
    dataproc_max_age               = 172800 // seconds
    dataproc_max_idle              = 600    // seconds

    // VQSR, as in cpg-flow-seqr-loader. The filter levels are the truth sensitivities ApplyVQSR filters at
    vqsr                           = true // if false, the run stops after densifying
    vqsr_fragments_per_job         = 100  // header-per-shard shards per tranche-training and apply task
    annotate_fragments_per_job     = 100  // whole fragments per task copying VQSR's results onto them
    snp_filter_level               = 99.8
    indel_filter_level             = 99.0
    vqsr_hapmap                    = 'gs://cpg-common-main/references/hg38/v0/hapmap_3.3.hg38.vcf.gz'
    vqsr_omni                      = 'gs://cpg-common-main/references/hg38/v0/1000G_omni2.5.hg38.vcf.gz'
    vqsr_one_thousand_genomes      = 'gs://cpg-common-main/references/hg38/v0/1000G_phase1.snps.high_confidence.hg38.vcf.gz'
    vqsr_dbsnp                     = 'gs://cpg-common-main/references/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf'
    vqsr_mills                     = 'gs://cpg-common-main/references/hg38/v0/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
    vqsr_axiom_poly                = 'gs://cpg-common-main/references/hg38/v0/Axiom_Exome_Plus.genotypes.all_populations.poly.hg38.vcf.gz'

    // metamist and cpg_utils, for the sample sheet generation, analysis registration, and the Dataproc client
    // contains metamist, cpg-utils 5.9.0, gcloud, and bcftools 1.25
    cpg_container                  = "australia-southeast1-docker.pkg.dev/cpg-common/images/nf_bcftools_gcloud:1.25-2"
    gatk_container                 = "australia-southeast1-docker.pkg.dev/cpg-common/images/gatk:4.6.2.0-1"
}

includeConfig "${projectDir}/conf/base.config"

profiles {
    // until we have profile selection in analysis-runner, google-batch is the standard route
    standard {
        process.executor = 'google-batch'
        google.location = 'australia-southeast1'
        // spot can't be set per process, and preempting the submitter would tear down the cluster
        google.batch.spot = false
    }
    docker {
        docker.enabled = true
    }
    // offline wiring checks: nextflow run main.nf -profile test -stub ...
    test {
        params.dataset = 'stub'
        process.executor = 'local'
        params.arGuid = 'local-test'
        params.accessLevel = 'standard'
        // never used: the local executor runs without docker, and stubs never start a cluster
        params.cpg_container = 'stub'
        params.dataproc_project = 'stub-nnnn'
        params.dataproc_autoscaling_policy = 'stub'
        params.register = false
        // VQSR stages its inputs from GCS, which a stub run can't reach
        params.vqsr = false
        params.output_root = 'results'
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
