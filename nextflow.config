manifest {
    name = 'nf-combine'
    description = 'Single-sample gVCFs -> one Hail VDS on an ephemeral Dataproc cluster, driven by Metamist cohorts'
    mainScript = 'main.nf'
    nextflowVersion = '>=25.10'
}

params {
    // what to combine: exactly one of cohorts (queried in Metamist) or samplesheet (a prepared TSV: sg_id, gvcf, dataset)
    dataset                        = null
    sequencing_type                = null  // genome | exome
    accessLevel                    = null  // full | standard, or test: <dataset>-test project and bucket
    arGuid                         = null  // supplied from analysis-runner, used in billing labels and the cluster name
    cohorts                        = null  // COH1,COH2 on the command line, or a list in a config file
    samplesheet                    = null  // a prepared sheet: no Metamist query, no base VDS discovery, no registration
    output_vds                     = null  // the VDS a --samplesheet run writes; required with it, and only with it

    force                          = false // fresh build: no base VDS, and any saved combiner plan is discarded
    base_vds                       = null  // build on this VDS, instead of the newest registered one. Not with force
    refresh                        = null  // SG IDs whose data is replaced from their current gVCF
    register                       = true  // if false, no metamist registration

    // the regions the combiner partitions on, chosen by sequencing_type
    exome_combiner_intervals = 'gs://cpg-common-main/rd_references/exome_combiner_intervals/500_var_balanced_intervals.bed'
    exome_densify_intervals = 'gs://cpg-common-main/rd_references/exome_combiner_intervals/100_var_balanced_intervals.bed'

    genome_combiner_intervals = 'gs://cpg-common-main/rd_references/genome_combiner_intervals/5000_var_balanced_intervals.bed'
    genome_densify_intervals = 'gs://cpg-common-main/rd_references/genome_combiner_intervals/2000_var_balanced_intervals.bed'

    // combiner tuning, shared by genome and exome until there's exome data to tune on.
    // target_records is the OurDNA cpg-flow default; the other two are tuned for checkpoint frequency.
    target_records                 = 1000000
    branch_factor                  = 100
    gvcf_batch_size                = 5

    // Dataproc cluster. The four with no default must be supplied by the launch config
    dataproc_region                = 'australia-southeast1'
    dataproc_service_account       = null  // the cluster VMs run as this, so they inherit its dataset access
    dataproc_autoscaling_policy    = null
    dataproc_master_type           = 'n1-highmem-8'
    dataproc_worker_type           = 'n1-highmem-16'
    dataproc_num_workers           = 2
    dataproc_num_secondary_workers = 10
    preemptible_secondary_workers  = true
    dataproc_boot_disk_size_gb     = 100
    dataproc_num_local_ssds        = 1
    dataproc_max_age               = 172800 // seconds
    dataproc_max_idle              = 600    // seconds

    // metamist and cpg_utils, for the sample sheet generation, analysis registration, and the Dataproc client
    cpg_container                  = "australia-southeast1-docker.pkg.dev/cpg-common/images/nf_base:5.8.1-1"
}

// the dataset bucket: the VDS and the run records are both laid out under it
outputDir = "gs://cpg-${params.dataset}-${params.accessLevel == 'test' ? 'test' : 'main'}"

workflow.output.mode = 'copy'

includeConfig "${projectDir}/conf/base.config"

profiles {
    // until we have profile selection in analysis-runner, google-batch is the standard route
    standard {
        process.executor = 'google-batch'
        google.location = 'australia-southeast1'
        // spot can't be set per process, and preempting the submitter would tear down the cluster (ADR 0003)
        google.batch.spot = false
    }
    docker {
        docker.enabled = true
    }
    // offline wiring checks: nextflow run main.nf -profile test -stub ...
    test {
        process.executor = 'local'
        params.arGuid = 'local-test'
        params.accessLevel = 'standard'
        // never used: the local executor runs without docker, and stubs never start a cluster
        params.cpg_container = 'stub'
        params.dataproc_service_account = 'stub@stub.iam.gserviceaccount.com'
        params.dataproc_staging_bucket = 'gs://stub-staging'
        params.dataproc_autoscaling_policy = 'stub'
        params.exome_intervals = 'gs://stub/exome.bed'
        params.register = false
        outputDir = 'results'
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
